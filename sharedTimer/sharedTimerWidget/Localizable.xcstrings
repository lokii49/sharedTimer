    "A timer or countdown with a remaining-time ring. Tap to open its details.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤقت أو عد تنازلي مع حلقة للوقت المتبقي. اضغط لفتح تفاصيله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকি সময়ের রিংসহ একটি টাইমার বা কাউন্টডাউন। বিস্তারিত দেখতে ট্যাপ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador o cuenta atrás con un anillo de tiempo restante. Tócalo para ver los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un minuteur ou un compte à rebours avec un anneau de temps restant. Touchez pour ouvrir les détails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बचे समय की रिंग वाला टाइमर या काउंटडाउन। विवरण खोलने के लिए टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer atau hitung mundur dengan cincin sisa waktu. Ketuk untuk membuka detailnya."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um timer ou contagem regressiva com um anel de tempo restante. Toque para ver os detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймер или обратный отсчет с кольцом оставшегося времени. Коснитесь, чтобы открыть подробности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带有剩余时间圆环的计时器或倒计时。轻点可查看详细信息。"
          }
        }
      }
    },
