    "Pick one timer or countdown to show big, on its own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مؤقتًا أو عدًا تنازليًا واحدًا لعرضه بحجم كبير بمفرده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলাদাভাবে বড় করে দেখাতে একটি টাইমার বা কাউন্টডাউন বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un temporizador o cuenta atrás para mostrarlo en grande, solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un minuteur ou un compte à rebours à afficher en grand, seul."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़े आकार में अकेले दिखाने के लिए एक टाइमर या काउंटडाउन चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu timer atau hitung mundur untuk ditampilkan besar, sendirian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um timer ou contagem regressiva para exibir em destaque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите один таймер или отсчет для крупного показа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个计时器或倒计时，单独大字显示。"
          }
        }
      }
    },
    "Pick which timer or countdown this widget shows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المؤقت أو العد التنازلي الذي تعرضه هذه الأداة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই উইজেট কোন টাইমার বা কাউন্টডাউন দেখাবে তা বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué temporizador o cuenta atrás muestra este widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le minuteur ou compte à rebours affiché par ce widget."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि यह विजेट कौन-सा टाइमर या काउंटडाउन दिखाए।"
          }
