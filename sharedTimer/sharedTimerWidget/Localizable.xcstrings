    "Lists every active timer and countdown, soonest first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض كل مؤقت وعد تنازلي نشط، الأقرب أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব সক্রিয় টাইমার ও কাউন্টডাউন দেখায়, যেটি আগে শেষ হবে সেটি প্রথমে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los temporizadores y cuentas atrás activos, empezando por el más próximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche tous les minuteurs et comptes à rebours actifs, du plus proche au plus lointain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सक्रिय टाइमर और काउंटडाउन दिखाता है, सबसे जल्दी वाला पहले।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan semua timer dan hitung mundur aktif, yang terdekat lebih dulu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista todos os timers e contagens regressivas ativos, do mais próximo ao mais distante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает все активные таймеры и отсчеты, ближайшие сначала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出所有进行中的计时器和倒计时，最早结束的排在前面。"
          }
        }
      }
    },
