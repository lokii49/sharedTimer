    "Choose a timer synced from your iPhone, or show the next active timer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择从 iPhone 同步的计时器，或显示下一个进行中的计时器。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone से सिंक किया टाइमर चुनें, या अगला चालू टाइमर दिखाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un temporizador sincronizado desde tu iPhone o muestra el siguiente activo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مؤقتًا متزامنًا من iPhone، أو اعرض المؤقت النشط التالي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un minuteur synchronisé depuis votre iPhone, ou affichez le prochain minuteur actif."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone থেকে সিঙ্ক করা একটি টাইমার বেছে নিন, বা পরের চালু টাইমার দেখান।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um timer sincronizado do iPhone ou mostre o próximo timer ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите таймер, синхронизированный с iPhone, или показывайте следующий активный."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih timer yang disinkronkan dari iPhone, atau tampilkan timer aktif berikutnya."
          }
        }
      }
    },
