    "See a synced timer on your watch face or in the Smart Stack.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表盘或智能叠放中查看同步的计时器。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वॉच फ़ेस या स्मार्ट स्टैक में सिंक किया टाइमर देखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta un temporizador sincronizado en la esfera o en la pila inteligente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض مؤقتًا متزامنًا على واجهة الساعة أو في المجموعة الذكية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un minuteur synchronisé sur le cadran ou dans la pile intelligente."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়াচ ফেস বা স্মার্ট স্ট্যাকে সিঙ্ক করা টাইমার দেখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja um timer sincronizado no mostrador ou na Pilha Inteligente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизированный таймер на циферблате или в Смарт-стопке."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat timer yang disinkronkan di wajah jam atau Smart Stack."
          }
        }
      }
    },
