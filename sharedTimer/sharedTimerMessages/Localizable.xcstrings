    "Full-screen alarms are off for Timer, so this will only send a notification, which follows the silent switch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منبهات ملء الشاشة متوقفة لتطبيق Timer، لذا سيُرسَل إشعار فقط، ويتبع مفتاح الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer-এর জন্য ফুল-স্ক্রিন অ্যালার্ম বন্ধ, তাই শুধু একটি নোটিফিকেশন যাবে, যা সাইলেন্ট সুইচ মেনে চলে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas a pantalla completa están desactivadas para Timer, así que solo se enviará una notificación, que respeta el interruptor de silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes plein écran sont désactivées pour Timer : seule une notification sera envoyée, soumise au mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer के लिए फ़ुल-स्क्रीन अलार्म बंद हैं, इसलिए यह केवल एक सूचना भेजेगा, जो साइलेंट स्विच का पालन करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm layar penuh dinonaktifkan untuk Timer, jadi hanya notifikasi yang dikirim, dan itu mengikuti sakelar senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes em tela cheia estão desativados para o Timer, então só será enviada uma notificação, que respeita a chave de silêncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранные будильники для Timer выключены, поэтому придёт только уведомление, которое подчиняется беззвучному режиму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer 的全屏闹钟已关闭，因此只会发送通知，并遵循静音开关。"
          }
        }
      }
    },
