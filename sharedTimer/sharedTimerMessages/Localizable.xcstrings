          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续后才能更改日期。"
          }
        }
      }
    },
    "Rings full-screen with Stop and Next Year, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن بملء الشاشة مع «إيقاف» و«السنة التالية»، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে বাজে, থামান ও পরের বছর সহ — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena a pantalla completa con Detener y Próximo año, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne en plein écran avec Arrêter et Année suivante, même app fermée ou téléphone en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर बजता है, रोकें और अगला साल के साथ — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi layar penuh dengan Hentikan dan Tahun Depan, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em tela cheia com Parar e Próximo Ano, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит на весь экран с кнопками «Стоп» и «Следующий год», даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏响铃，带“停止”和“下一年”按钮；即使 App 已关闭或手机处于静音状态也会响铃。"
          }
        }
      }
    },
    "Rings full-screen with Stop and Repeat, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن بملء الشاشة مع «إيقاف» و«تكرار»، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে বাজে, থামান ও পুনরাবৃত্তি সহ — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena a pantalla completa con Detener y Repetir, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne en plein écran avec Arrêter et Répéter, même app fermée ou téléphone en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर बजता है, रोकें और दोहराएँ के साथ — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi layar penuh dengan Hentikan dan Ulangi, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em tela cheia com Parar e Repetir, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит на весь экран с кнопками «Стоп» и «Повторить», даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏响铃，带“停止”和“重复”按钮；即使 App 已关闭或手机处于静音状态也会响铃。"
          }
        }
      }
    },
    "Rings full-screen with Stop and a button to skip to the next one, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏响铃，带“停止”和跳到下一次的按钮，即使 App 已关闭或手机处于静音。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन बजता है, रोकें और अगले पर जाने के बटन के साथ, ऐप बंद या फ़ोन साइलेंट होने पर भी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena a pantalla completa con Detener y un botón para saltar al siguiente, incluso con la app cerrada o el iPhone en silencio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن بملء الشاشة مع زر إيقاف وزر للانتقال إلى التالي، حتى عندما يكون التطبيق مغلقًا أو الهاتف صامتًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne en plein écran avec Arrêter et un bouton pour passer au suivant, même app fermée ou iPhone en silencieux."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফুল-স্ক্রিনে বাজে, বন্ধ ও পরেরটিতে যাওয়ার বোতামসহ, অ্যাপ বন্ধ বা ফোন সাইলেন্ট থাকলেও।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em tela cheia com Parar e um botão para pular para o próximo, mesmo com o app fechado ou o iPhone no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит на весь экран с кнопками «Стоп» и перехода к следующему, даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi layar penuh dengan Hentikan dan tombol untuk lompat ke berikutnya, bahkan saat app ditutup atau iPhone senyap."
          }
        }
      }
    },
