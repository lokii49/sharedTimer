    "+1:00": {},
    "A plain link that opens for anyone, app or not.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط عادي يفتح لأي شخص، سواء لديه التطبيق أم لا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সাধারণ লিঙ্ক যা যে কেউ খুলতে পারে, অ্যাপ থাকুক বা না থাকুক।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace sencillo que cualquiera puede abrir, tenga o no la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien simple qui s’ouvre pour tout le monde, avec ou sans l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सादा लिंक जो सभी के लिए खुलता है, ऐप हो या न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan biasa yang bisa dibuka siapa saja, dengan atau tanpa app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link simples que abre para qualquer pessoa, com ou sem o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычная ссылка, открывается у всех — с приложением и без."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个普通链接，任何人都能打开，无论是否安装了 App。"
          }
        }
      }
    },
    "A richer bubble, but it only works if your friend has Timer too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقاعة أغنى، لكنها تعمل فقط إذا كان لدى صديقك Timer أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরও সমৃদ্ধ বাবল, তবে এটি কেবল তখনই কাজ করে যদি আপনার বন্ধুরও Timer থাকে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una burbuja más completa, pero solo funciona si tu amigo también tiene Timer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bulle plus riche, mais elle ne fonctionne que si votre ami a aussi Timer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बेहतर बबल, लेकिन यह तभी काम करता है जब आपके दोस्त के पास भी Timer हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelembung yang lebih kaya, tapi hanya berfungsi jika temanmu juga punya Timer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um balão mais completo, mas só funciona se seu amigo também tiver o Timer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более наглядный пузырь, но работает, только если у друга тоже есть Timer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "气泡内容更丰富，但需要你的朋友也装有 Timer。"
          }
        }
      }
    },
