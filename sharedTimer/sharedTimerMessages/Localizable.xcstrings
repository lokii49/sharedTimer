    "Resume to change the date.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف لتغيير التاريخ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখ পরিবর্তন করতে পুনরায় শুরু করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda para cambiar la fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez pour modifier la date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीख बदलने के लिए फिर शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan untuk mengubah tanggal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome para alterar a data."
          }
        },
        "ru": {
          "stringUnit": {
