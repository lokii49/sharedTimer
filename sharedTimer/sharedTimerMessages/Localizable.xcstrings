    "What should we call you?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们该怎么称呼你？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपको क्या कहें?"
          }
        },
        "es": {
