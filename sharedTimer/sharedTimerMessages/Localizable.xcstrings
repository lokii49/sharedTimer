    "Buzzes full-screen with Stop and Next Year, no sound, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏振动，带“停止”和“下一年”按钮，无声音；即使 App 已关闭或手机处于静音状态也会提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर वाइब्रेट करता है, रोकें और अगला साल के साथ, बिना आवाज़ के — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra a pantalla completa con Detener y Próximo año, sin sonido, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يهتز بملء الشاشة مع «إيقاف» و«السنة التالية»، دون صوت، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibre en plein écran avec Arrêter et Année suivante, sans son, même app fermée ou téléphone en mode silencieux."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে কম্পন করে, থামান ও পরের বছর সহ, কোনো শব্দ ছাড়া — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra em tela cheia com Parar e Próximo Ano, sem som, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрирует на весь экран с кнопками «Стоп» и «Следующий год», без звука, даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergetar layar penuh dengan Hentikan dan Tahun Depan, tanpa suara, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        }
      }
    },
    "Buzzes full-screen with Stop and Repeat, no sound, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏振动，带“停止”和“重复”按钮，无声音；即使 App 已关闭或手机处于静音状态也会提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर वाइब्रेट करता है, रोकें और दोहराएँ के साथ, बिना आवाज़ के — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra a pantalla completa con Detener y Repetir, sin sonido, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يهتز بملء الشاشة مع «إيقاف» و«تكرار»، دون صوت، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibre en plein écran avec Arrêter et Répéter, sans son, même app fermée ou téléphone en mode silencieux."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে কম্পন করে, থামান ও পুনরাবৃত্তি সহ, কোনো শব্দ ছাড়া — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra em tela cheia com Parar e Repetir, sem som, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрирует на весь экран с кнопками «Стоп» и «Повторить», без звука, даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergetar layar penuh dengan Hentikan dan Ulangi, tanpa suara, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        }
      }
    },
    "Choose a different timer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار مؤقت آخر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি টাইমার বেছে নিন"
          }
        },
        "es": {
