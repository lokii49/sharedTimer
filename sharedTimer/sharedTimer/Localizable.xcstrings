    "Target date": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ المستهدف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক্ষ্য তারিখ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Date cible"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य तारीख"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal target"
          }
        },
        "pt-BR": {
          "stringUnit": {
