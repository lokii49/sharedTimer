    "Tap + to start one, or share a timer from iMessage.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 新建一个，或从 iMessage 共享计时器。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए + पर टैप करें, या iMessage से टाइमर शेयर करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para crear uno o comparte un temporizador desde iMessage."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على + لبدء مؤقت، أو شارك مؤقتًا من iMessage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour en créer un, ou partagez un minuteur depuis iMessage."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে + ট্যাপ করুন, অথবা iMessage থেকে একটি টাইমার শেয়ার করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em + para iniciar um ou compartilhe um timer pelo iMessage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите +, чтобы создать таймер, или поделитесь им из iMessage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk + untuk memulai, atau bagikan timer dari iMessage."
          }
        }
      }
    },
