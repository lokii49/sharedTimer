    "Save this sequence to select and start it again later without rebuilding it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储此序列，以后可直接选择并再次开始，无需重新创建。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सीक्वेंस सहेजें ताकि बाद में बिना दोबारा बनाए इसे चुनकर फिर शुरू कर सकें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta secuencia para elegirla e iniciarla de nuevo más tarde sin volver a crearla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ هذا التسلسل لتختاره وتبدأه مرة أخرى لاحقًا دون إعادة إنشائه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez cette séquence pour la sélectionner et la relancer plus tard sans la recréer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন করে তৈরি না করেই পরে আবার বেছে নিয়ে শুরু করতে এই সিকোয়েন্সটি সংরক্ষণ করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve esta sequência para selecioná-la e iniciá-la novamente depois, sem precisar recriá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните последовательность, чтобы потом выбрать и запустить ее снова, не собирая заново."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan urutan ini untuk dipilih dan dimulai lagi nanti tanpa menyusunnya ulang."
          }
        }
      }
    },
    "Saved as Template": {
      "localizations": {
