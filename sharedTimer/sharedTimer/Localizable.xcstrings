    "Alarm sound · this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوت المنبه · هذا الـ iPhone"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্মের শব্দ · এই iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonido de alarma · este iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son d’alarme · cet iPhone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म ध्वनि · यह iPhone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara alarm · iPhone ini"
          }
        },
        "pt-BR": {
