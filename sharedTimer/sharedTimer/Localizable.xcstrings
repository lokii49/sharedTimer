    "Work, then rest, on repeat.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعمل ثم استرح، مرارًا وتكرارًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজ, তারপর বিশ্রাম, বারবার।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja y descansa, una y otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travailler, puis se reposer, en boucle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम, फिर आराम, बार-बार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerja, lalu istirahat, berulang."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalhe, depois descanse, sem parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа, потом отдых, по кругу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作，然后休息，循环往复。"
          }
        }
