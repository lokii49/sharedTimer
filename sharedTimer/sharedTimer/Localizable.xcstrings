    "A quiet notification instead — no ringing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار هادئ بدلًا من ذلك — بلا رنين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর বদলে একটি নিঃশব্দ বিজ্ঞপ্তি — কোনো রিং নয়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una notificación discreta, sin sonar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification discrète à la place, sans sonnerie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बजाय एक शांत सूचना — कोई घंटी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi senyap saja — tanpa dering."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação discreta — sem tocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо этого — тихое уведомление без звонка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为发送一条安静的通知，不会响铃。"
          }
        }
      }
    },
    "A sequence runs each phase below back-to-back, then loops the whole thing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل التسلسل كل مرحلة أدناه تباعًا، ثم يكرر الكل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সিকোয়েন্স নিচের প্রতিটি ধাপ পরপর চালায়, তারপর পুরোটা আবার লুপ করে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una secuencia ejecuta cada fase seguida y luego repite todo el ciclo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séquence enchaîne chaque phase ci-dessous, puis recommence l’ensemble en boucle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीक्वेंस नीचे दिए हर चरण को एक के बाद एक चलाता है, फिर पूरे क्रम को दोहराता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutan menjalankan setiap fase di bawah secara berurutan, lalu mengulang semuanya."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sequência executa cada fase abaixo em seguida e depois repete tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последовательность запускает фазы ниже одну за другой, а затем повторяет всё по кругу."
