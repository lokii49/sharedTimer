    "People you share with hear their own choice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمع الأشخاص الذين تشارك معهم الصوت الذي يختارونه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাদের সাথে শেয়ার করেন তারা নিজেদের বেছে নেওয়া শব্দ শোনেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas con quienes compartes oyen su propia elección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes avec qui vous partagez entendent leur propre choix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनके साथ आप शेयर करते हैं, वे अपनी चुनी हुई ध्वनि सुनते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang berbagi denganmu mendengar pilihan mereka sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem compartilha com você ouve a própria escolha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, с кем вы делитесь, слышат свой выбор."
