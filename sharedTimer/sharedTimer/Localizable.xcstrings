    "Start from scratch and add whatever phases you like.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ من الصفر وأضف ما تشاء من المراحل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একদম শুরু থেকে বানান, ইচ্ছেমতো ধাপ যোগ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza desde cero y añade las fases que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partez de zéro et ajoutez les phases de votre choix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत से बनाएँ और जो चाहें वे चरण जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari nol dan tambahkan fase sesukamu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece do zero e adicione as fases que quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с нуля и добавьте любые фазы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从零开始，随意添加阶段。"
          }
        }
      }
    },
    "Start it again any time from New Sequence → Start from.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأه مرة أخرى في أي وقت من تسلسل جديد ← البدء من."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন সিকোয়েন্স → যেখান থেকে শুরু থেকে যেকোনো সময় এটি আবার শুরু করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iníciala de nuevo cuando quieras desde Nueva secuencia → Empezar desde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez-la à tout moment depuis Nouvelle séquence → Partir de."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे कभी भी नया सीक्वेंस → इससे शुरू करें में जाकर फिर शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai lagi kapan saja dari Urutan Baru → Mulai dari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie-a novamente quando quiser em Nova Sequência → Começar com."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите ее снова в любой момент: Новая последовательность → Начать с."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以从“新建序列”→“起始模板”再次开始。"
          }
        }
      }
    },
