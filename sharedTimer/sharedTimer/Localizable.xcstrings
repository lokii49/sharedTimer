    },
    "Add at least one phase to start this sequence.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少添加一个阶段才能开始此序列。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सीक्वेंस शुरू करने के लिए कम से कम एक चरण जोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al menos una fase para iniciar esta secuencia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مرحلة واحدة على الأقل لبدء هذا التسلسل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez au moins une phase pour démarrer cette séquence."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সিকোয়েন্স শুরু করতে অন্তত একটি ধাপ যোগ করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pelo menos uma fase para iniciar esta sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте хотя бы одну фазу, чтобы запустить последовательность."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan setidaknya satu fase untuk memulai urutan ini."
          }
        }
      }
    },
    "Add time to a running or paused timer, countdown, or current sequence phase.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为正在运行或已暂停的计时器、倒计时或当前序列阶段增加时间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे या पॉज़ किए गए टाइमर, काउंटडाउन या सीक्वेंस के मौजूदा चरण में समय जोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tiempo a un temporizador o cuenta atrás en marcha o en pausa, o a la fase actual de una secuencia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف وقتًا إلى مؤقت أو عد تنازلي قيد التشغيل أو متوقف مؤقتًا، أو إلى المرحلة الحالية من التسلسل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez du temps à un minuteur, un compte à rebours ou à la phase en cours d’une séquence, en cours ou en pause."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলমান বা বিরতিতে থাকা টাইমার, কাউন্টডাউন বা সিকোয়েন্সের বর্তমান ধাপে সময় যোগ করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione tempo a um timer, contagem regressiva ou fase atual de uma sequência, em andamento ou pausado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить время к идущему или приостановленному таймеру, отсчету или текущей фазе последовательности."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan waktu ke timer, hitung mundur, atau fase urutan saat ini yang berjalan atau dijeda."
          }
        }
      }
    },
