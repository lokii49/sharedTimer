            "state": "translated",
            "value": "শুধু দেখা"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ver"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ देखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya lihat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente visualização"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查看"
          }
        }
      }
    },
    "View-only: people who scan this see the countdown but can't change it, and it won't follow later pauses or extensions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للعرض فقط: يرى من يمسح هذا الرمز العد التنازلي لكن لا يمكنه تغييره، ولن يتبع الإيقافات المؤقتة أو التمديدات اللاحقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু দেখার জন্য: যারা এটি স্ক্যান করবেন তারা কাউন্টডাউন দেখতে পাবেন কিন্তু পরিবর্তন করতে পারবেন না, এবং পরের বিরতি বা সময় বাড়ানো এতে দেখাবে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura: quien escanee esto verá la cuenta atrás, pero no podrá cambiarla, y no reflejará pausas ni ampliaciones posteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule : les personnes qui scannent ce code voient le compte à rebours sans pouvoir le modifier, et il ne suivra pas les pauses ou prolongations ultérieures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल देखने के लिए: इसे स्कैन करने वाले काउंटडाउन देख सकते हैं, लेकिन बदल नहीं सकते, और यह बाद के पॉज़ या बढ़ाए गए समय को फ़ॉलो नहीं करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya lihat: orang yang memindai ini dapat melihat hitung mundur tetapi tidak bisa mengubahnya, dan tidak akan mengikuti jeda atau perpanjangan berikutnya."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente visualização: quem escanear verá a contagem regressiva, mas não poderá alterá-la, e ela não acompanhará pausas ou extensões posteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр: кто отсканирует код, увидит отсчет, но не сможет его изменить, и последующие паузы и продления в нем не отразятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供查看：扫描此码的人可以看到倒计时，但无法更改，之后的暂停或延长也不会同步。"
          }
        }
      }
    },
