    "Timers won't alert you while the app is in the background until notifications are allowed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تنبهك المؤقتات أثناء وجود التطبيق في الخلفية حتى تسمح بالإشعارات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তির অনুমতি না দেওয়া পর্যন্ত অ্যাপ ব্যাকগ্রাউন্ডে থাকলে টাইমার আপনাকে সতর্ক করবে না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temporizadores no te avisarán mientras la app esté en segundo plano hasta que permitas las notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minuteurs ne vous alerteront pas lorsque l’app est en arrière-plan tant que les notifications ne sont pas autorisées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाओं की अनुमति मिलने तक, ऐप बैकग्राउंड में होने पर टाइमर आपको अलर्ट नहीं करेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer tidak akan memberi peringatan saat app di latar belakang hingga notifikasi diizinkan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os timers não vão alertar você com o app em segundo plano até que as notificações sejam permitidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока уведомления не разрешены, таймеры не смогут оповестить вас, когда приложение в фоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在允许通知之前，App 在后台时计时器不会提醒你。"
          }
        }
      }
    },
