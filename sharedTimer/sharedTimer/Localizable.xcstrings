    "Added %@ to %@. It is still paused with %@ left.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Added %1$@ to %2$@. It is still paused with %3$@ left."
          }
        },
        "zh-Hans": {
          "stringUnit": {
