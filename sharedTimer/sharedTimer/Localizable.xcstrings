    "No upcoming events in the next year. You can enter a date yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أحداث قادمة خلال العام المقبل. يمكنك إدخال تاريخ بنفسك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামী এক বছরে কোনো ইভেন্ট নেই। আপনি নিজে তারিখ লিখতে পারেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay eventos en el próximo año. Puedes introducir una fecha tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement dans l’année à venir. Vous pouvez saisir une date vous-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले साल में कोई आने वाला इवेंट नहीं है। आप खुद तारीख डाल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada acara dalam setahun ke depan. Anda bisa memasukkan tanggal sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum evento no próximo ano. Você pode inserir uma data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайший год событий нет. Можно ввести дату вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来一年内没有日程。你可以自己输入日期。"
          }
        }
      }
    },
