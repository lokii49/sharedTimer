    "Choose an event in the next year. Its title and start time become your countdown; Calendar stays unchanged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حدثًا خلال السنة القادمة. سيصبح عنوانه ووقت بدئه العد التنازلي، ويبقى التقويم دون تغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামী এক বছরের মধ্যে একটি ইভেন্ট বেছে নিন। এর শিরোনাম ও শুরুর সময় আপনার কাউন্টডাউন হবে; ক্যালেন্ডার অপরিবর্তিত থাকবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un evento del próximo año. Su título y hora de inicio se convertirán en tu cuenta atrás; Calendario no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un événement de l’année à venir. Son titre et son heure de début deviennent votre compte à rebours ; Calendrier reste inchangé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले एक साल का कोई इवेंट चुनें। उसका शीर्षक और शुरू होने का समय आपका काउंटडाउन बन जाएगा; कैलेंडर में कोई बदलाव नहीं होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih acara dalam setahun ke depan. Judul dan waktu mulainya menjadi hitung mundurmu; Kalender tidak diubah."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um evento dos próximos 12 meses. O título e o horário de início viram sua contagem regressiva; o Calendário não é alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите событие в ближайший год. Его название и время начала станут вашим отсчетом; Календарь не изменится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择未来一年内的一个日程。它的标题和开始时间将成为你的倒计时；日历保持不变。"
          }
        }
      }
    },
