    "Repeats at this date and time in %@. February 29 uses February 28 in non-leap years. Open Timer each year to keep future reminders scheduled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتكرر في هذا التاريخ والوقت حسب توقيت %@. يُستخدم 28 فبراير بدلًا من 29 فبراير في السنوات غير الكبيسة. افتح Timer كل سنة لإبقاء التذكيرات القادمة مجدولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ এই তারিখ ও সময়ে পুনরাবৃত্তি হয়। অধিবর্ষ না হলে ২৯ ফেব্রুয়ারির বদলে ২৮ ফেব্রুয়ারি ব্যবহার হয়। ভবিষ্যতের রিমাইন্ডার নির্ধারিত রাখতে প্রতি বছর Timer খুলুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se repite en esta fecha y hora en %@. El 29 de febrero pasa al 28 de febrero en los años no bisiestos. Abre Timer cada año para mantener programados los próximos avisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se répète à cette date et à cette heure (%@). Le 29 février devient le 28 février les années non bissextiles. Ouvrez Timer chaque année pour que les rappels futurs restent programmés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में इस तारीख और समय पर दोहराता है। लीप वर्ष न होने पर 29 फ़रवरी की जगह 28 फ़रवरी इस्तेमाल होती है। आगे के रिमाइंडर शेड्यूल रखने के लिए हर साल Timer खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berulang pada tanggal dan waktu ini di %@. 29 Februari menggunakan 28 Februari di tahun non-kabisat. Buka Timer setiap tahun agar pengingat berikutnya tetap terjadwal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repete nesta data e horário em %@. 29 de fevereiro usa 28 de fevereiro em anos não bissextos. Abra o Timer a cada ano para manter os próximos lembretes agendados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяется в эту дату и время (%@). 29 февраля в невисокосные годы заменяется на 28 февраля. Открывайте Timer раз в год, чтобы будущие напоминания оставались запланированными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在%@的这一日期和时间重复。非闰年时，2月29日改为2月28日。请每年打开一次 Timer，以确保后续提醒保持排程。"
          }
        }
      }
    },
