    "It stops for everyone you shared it with.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف لدى كل من شاركته معهم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যাদের সাথে শেয়ার করেছেন, তাদের সবার জন্য এটি থেমে যাবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detendrá para todas las personas con las que lo compartiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’arrête pour toutes les personnes avec qui vous l’avez partagé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनके साथ आपने इसे शेयर किया, उन सभी के लिए यह रुक जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer ini berhenti untuk semua orang yang Anda bagikan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele para para todas as pessoas com quem você compartilhou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он остановится у всех, с кем вы им поделились."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与你共享的所有人都会停止该计时器。"
          }
        }
      }
    },
