    "Read a timer's remaining time. Returns seconds for use in other Shortcut actions; for sequences this is the current phase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ الوقت المتبقي في مؤقت. يُرجع الثواني لاستخدامها في إجراءات الاختصارات الأخرى؛ وفي التسلسلات يكون هذا للمرحلة الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি টাইমারের বাকি সময় পড়ুন। অন্যান্য শর্টকাট অ্যাকশনে ব্যবহারের জন্য সেকেন্ড ফেরত দেয়; সিকোয়েন্সের ক্ষেত্রে এটি বর্তমান ধাপের সময়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el tiempo restante de un temporizador. Devuelve segundos para usar en otras acciones de Atajos; en las secuencias, corresponde a la fase actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le temps restant d’un minuteur. Renvoie des secondes utilisables dans d’autres actions Raccourcis ; pour une séquence, il s’agit de la phase en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमर का बचा समय पढ़ें। दूसरे शॉर्टकट ऐक्शन में इस्तेमाल के लिए सेकंड लौटाता है; सीक्वेंस के लिए यह मौजूदा चरण का समय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca sisa waktu timer. Mengembalikan detik untuk digunakan di tindakan Pintasan lain; untuk urutan, ini adalah fase saat ini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o tempo restante de um timer. Retorna segundos para usar em outras ações dos Atalhos; em sequências, refere-se à fase atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнать оставшееся время таймера. Возвращает секунды для других действий в Быстрых командах; для последовательности — время текущей фазы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取计时器的剩余时间。返回秒数，可用于其他快捷指令操作；对于序列，返回当前阶段的剩余时间。"
          }
        }
      }
    },
