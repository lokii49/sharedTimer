    "Resume a paused timer, countdown, or sequence phase.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续已暂停的计时器、倒计时或序列阶段。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉज़ किया गया टाइमर, काउंटडाउन या सीक्वेंस चरण फिर शुरू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda un temporizador, una cuenta atrás o una fase de secuencia en pausa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف مؤقتًا أو عدًا تنازليًا أو مرحلة تسلسل متوقفة مؤقتًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez un minuteur, un compte à rebours ou une phase de séquence en pause."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতিতে থাকা টাইমার, কাউন্টডাউন বা সিকোয়েন্সের ধাপ পুনরায় শুরু করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome um timer, contagem regressiva ou fase de sequência pausados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновить приостановленный таймер, отсчет или фазу последовательности."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan timer, hitung mundur, atau fase urutan yang dijeda."
          }
        }
      }
    },
    "Resume to change the date.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续后才能更改日期。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीख बदलने के लिए फिर शुरू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda para cambiar la fecha."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف لتغيير التاريخ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez pour modifier la date."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখ পরিবর্তন করতে পুনরায় শুরু করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome para alterar a data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите, чтобы изменить дату."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan untuk mengubah tanggal."
          }
        }
      }
    },
    "Rings or buzzes full-screen with Stop and Repeat, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏响铃或振动，并提供“停止”和“重复”按钮，即使 App 已关闭或手机处于静音模式也有效。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंद होने या फ़ोन साइलेंट पर होने पर भी, रोकें और दोहराएँ बटन के साथ फ़ुल-स्क्रीन बजता या वाइब्रेट करता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena o vibra a pantalla completa con Detener y Repetir, incluso con la app cerrada o el iPhone en silencio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن أو يهتز بملء الشاشة مع زرّي الإيقاف والتكرار، حتى عندما يكون التطبيق مغلقًا أو الهاتف في الوضع الصامت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne ou vibre en plein écran avec Arrêter et Répéter, même si l’app est fermée ou l’iPhone en mode silencieux."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ বন্ধ থাকলে বা ফোন সাইলেন্টে থাকলেও থামান ও পুনরাবৃত্তি বোতামসহ পূর্ণ স্ক্রিনে বাজে বা কম্পন করে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ou vibra em tela cheia com Parar e Repetir, mesmo com o app fechado ou o iPhone no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит или вибрирует на весь экран с кнопками «Стоп» и «Повторить», даже если приложение закрыто или включен бесшумный режим."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdering atau bergetar layar penuh dengan Hentikan dan Ulangi, bahkan saat app ditutup atau iPhone dalam mode senyap."
          }
        }
      }
    },
