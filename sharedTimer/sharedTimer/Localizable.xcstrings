    },
    "Allow Calendar access in Settings to choose an event. You can also enter a date yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى التقويم من الإعدادات لاختيار حدث. يمكنك أيضًا إدخال تاريخ بنفسك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইভেন্ট বেছে নিতে সেটিংসে ক্যালেন্ডার অ্যাক্সেসের অনুমতি দিন। আপনি নিজেও তারিখ লিখতে পারেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al Calendario en Ajustes para elegir un evento. También puedes introducir una fecha tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à Calendrier dans Réglages pour choisir un événement. Vous pouvez aussi saisir une date vous-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इवेंट चुनने के लिए सेटिंग्ज़ में कैलेंडर की अनुमति दें। आप खुद भी तारीख डाल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Kalender di Pengaturan untuk memilih acara. Anda juga bisa memasukkan tanggal sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Calendário em Ajustes para escolher um evento. Você também pode inserir uma data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к Календарю в Настройках, чтобы выбрать событие. Можно также ввести дату вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问日历以选择事件。你也可以自己输入日期。"
          }
        }
      }
    },
    "Anniversary reached!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلّت الذكرى!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্ষিকী এসে গেছে!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Aniversario alcanzado!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anniversaire atteint !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्षगांठ आ गई!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari jadi tiba!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aniversário chegou!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовщина наступила!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周年日到了！"
          }
        }
      }
    },
    "Buzzes full-screen with Stop and Next Year, no sound, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يهتز بملء الشاشة مع «إيقاف» و«السنة التالية»، دون صوت، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে কম্পন করে, থামান ও পরের বছর সহ, কোনো শব্দ ছাড়া — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra a pantalla completa con Detener y Próximo año, sin sonido, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibre en plein écran avec Arrêter et Année suivante, sans son, même app fermée ou téléphone en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर वाइब्रेट करता है, रोकें और अगला साल के साथ, बिना आवाज़ के — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergetar layar penuh dengan Hentikan dan Tahun Depan, tanpa suara, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra em tela cheia com Parar e Próximo Ano, sem som, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрирует на весь экран с кнопками «Стоп» и «Следующий год», без звука, даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏振动，带“停止”和“下一年”按钮，无声音；即使 App 已关闭或手机处于静音状态也会提醒。"
          }
        }
      }
    },
    "Buzzes full-screen with Stop and Repeat, no sound, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يهتز بملء الشاشة مع «إيقاف» و«تكرار»، دون صوت، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে কম্পন করে, থামান ও পুনরাবৃত্তি সহ, কোনো শব্দ ছাড়া — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra a pantalla completa con Detener y Repetir, sin sonido, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibre en plein écran avec Arrêter et Répéter, sans son, même app fermée ou téléphone en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर वाइब्रेट करता है, रोकें और दोहराएँ के साथ, बिना आवाज़ के — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergetar layar penuh dengan Hentikan dan Ulangi, tanpa suara, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra em tela cheia com Parar e Repetir, sem som, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрирует на весь экран с кнопками «Стоп» и «Повторить», без звука, даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏振动，带“停止”和“重复”按钮，无声音；即使 App 已关闭或手机处于静音状态也会提醒。"
          }
        }
      }
    },
    "Calendar events couldn’t be loaded. Try again or enter a date yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل أحداث التقويم. حاول مرة أخرى أو أدخل تاريخًا بنفسك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডারের ইভেন্ট লোড করা যায়নি। আবার চেষ্টা করুন বা নিজে তারিখ লিখুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los eventos del calendario. Inténtalo de nuevo o introduce una fecha tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les événements du calendrier. Réessayez ou saisissez une date vous-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर इवेंट लोड नहीं हो सके। फिर कोशिश करें या खुद तारीख डालें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara kalender tidak dapat dimuat. Coba lagi atau masukkan tanggal sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os eventos do calendário. Tente novamente ou insira uma data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить события календаря. Повторите попытку или введите дату вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入日历事件。请重试或自己输入日期。"
          }
        }
      }
    },
    "Can make changes": {
      "localizations": {
        "ar": {
          "stringUnit": {
