          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ में जोड़ा गया। यह अभी भी पॉज़ है, %@ बाकी है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha añadido %@ a %@. Sigue en pausa con %@ restante."
