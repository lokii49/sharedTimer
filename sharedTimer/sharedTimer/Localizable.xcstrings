        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retomar Timer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновить таймер"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续计时器"
          }
        }
      }
    },
    "Resume a paused timer, countdown, or sequence phase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف مؤقتًا أو عدًا تنازليًا أو مرحلة تسلسل متوقفة مؤقتًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতিতে থাকা টাইমার, কাউন্টডাউন বা সিকোয়েন্সের ধাপ পুনরায় শুরু করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda un temporizador, una cuenta atrás o una fase de secuencia en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez un minuteur, un compte à rebours ou une phase de séquence en pause."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉज़ किया गया टाइमर, काउंटडाउन या सीक्वेंस चरण फिर शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan timer, hitung mundur, atau fase urutan yang dijeda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome um timer, contagem regressiva ou fase de sequência pausados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновить приостановленный таймер, отсчет или фазу последовательности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续已暂停的计时器、倒计时或序列阶段。"
          }
        }
      }
    },
    "Resume to change the date.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استأنف لتغيير التاريخ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখ পরিবর্তন করতে পুনরায় শুরু করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda para cambiar la fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez pour modifier la date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीख बदलने के लिए फिर शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan untuk mengubah tanggal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome para alterar a data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите, чтобы изменить дату."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续后才能更改日期。"
          }
        }
      }
    },
    "Rings full-screen with Stop and Next Year, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن بملء الشاشة مع «إيقاف» و«السنة التالية»، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে বাজে, থামান ও পরের বছর সহ — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena a pantalla completa con Detener y Próximo año, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne en plein écran avec Arrêter et Année suivante, même app fermée ou téléphone en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर बजता है, रोकें और अगला साल के साथ — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi layar penuh dengan Hentikan dan Tahun Depan, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em tela cheia com Parar e Próximo Ano, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит на весь экран с кнопками «Стоп» и «Следующий год», даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏响铃，带“停止”和“下一年”按钮；即使 App 已关闭或手机处于静音状态也会响铃。"
          }
        }
      }
    },
    "Rings full-screen with Stop and Repeat, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن بملء الشاشة مع «إيقاف» و«تكرار»، حتى عندما يكون التطبيق مغلقًا أو الهاتف على الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ণ স্ক্রিনে বাজে, থামান ও পুনরাবৃত্তি সহ — অ্যাপ বন্ধ বা ফোন সাইলেন্টে থাকলেও।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena a pantalla completa con Detener y Repetir, incluso con la app cerrada o el teléfono en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne en plein écran avec Arrêter et Répéter, même app fermée ou téléphone en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ुल-स्क्रीन पर बजता है, रोकें और दोहराएँ के साथ — ऐप बंद हो या फ़ोन साइलेंट पर हो तब भी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi layar penuh dengan Hentikan dan Ulangi, bahkan saat app ditutup atau ponsel dalam mode senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em tela cheia com Parar e Repetir, mesmo com o app fechado ou o celular no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит на весь экран с кнопками «Стоп» и «Повторить», даже если приложение закрыто или включён беззвучный режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏响铃，带“停止”和“重复”按钮；即使 App 已关闭或手机处于静音状态也会响铃。"
          }
        }
      }
    },
    "Rings or buzzes full-screen with Stop and Next, even when the app is closed or the phone is on silent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن أو يهتز بملء الشاشة مع زرّي الإيقاف والتالي، حتى عندما يكون التطبيق مغلقًا أو الهاتف في الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ বন্ধ থাকলে বা ফোন সাইলেন্টে থাকলেও থামান ও পরবর্তী বোতামসহ পূর্ণ স্ক্রিনে বাজে বা কম্পন করে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena o vibra a pantalla completa con Detener y Siguiente, incluso con la app cerrada o el iPhone en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne ou vibre en plein écran avec Arrêter et Suivant, même si l’app est fermée ou l’iPhone en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंद होने या फ़ोन साइलेंट पर होने पर भी, रोकें और अगला बटन के साथ फ़ुल-स्क्रीन बजता या वाइब्रेट करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdering atau bergetar layar penuh dengan Hentikan dan Berikutnya, bahkan saat app ditutup atau iPhone dalam mode senyap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ou vibra em tela cheia com Parar e Próxima, mesmo com o app fechado ou o iPhone no silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит или вибрирует на весь экран с кнопками «Стоп» и «Далее», даже если приложение закрыто или включен бесшумный режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏响铃或振动，并提供“停止”和“下一个”按钮，即使 App 已关闭或手机处于静音模式也有效。"
          }
        }
      }
    },
    "Running, ends %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيد التشغيل، ينتهي %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলছে, শেষ হবে %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En curso, termina %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours, fin le %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहा है, %@ पर खत्म"
          }
        },
        "id": {
