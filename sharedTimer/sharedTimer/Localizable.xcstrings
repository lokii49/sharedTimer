    "Save a friend's Pomodoro or fasting plan as your own template.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ خطة بومودورو أو صيام من صديق كقالب خاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধুর পোমোডোরো বা উপবাসের প্ল্যান নিজের টেমপ্লেট হিসেবে সংরক্ষণ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el Pomodoro o el plan de ayuno de un amigo como tu propia plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le Pomodoro ou le plan de jeûne d’un ami comme votre propre modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दोस्त का पोमोडोरो या उपवास प्लान अपने टेम्पलेट के रूप में सहेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan rencana Pomodoro atau puasa teman sebagai templat Anda sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o Pomodoro ou o plano de jejum de um amigo como seu próprio modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните Помодоро или план голодания друга как собственный шаблон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将朋友的番茄钟或断食计划存储为你自己的模板。"
          }
        }
      }
    },
    "Save as New Sequence": {
