        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标日期"
          }
        }
      }
    },
    "Ten languages, clearer VoiceOver and larger text. Share works again from a timer's own screen, too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عشر لغات، وVoiceOver أوضح، ونص أكبر. كما عادت المشاركة للعمل من شاشة المؤقت نفسه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দশটি ভাষা, আরও স্পষ্ট VoiceOver এবং বড় টেক্সট। টাইমারের নিজের স্ক্রিন থেকেও আবার শেয়ার করা যায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez idiomas, VoiceOver más claro y texto más grande. Además, vuelves a poder compartir desde la pantalla del temporizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix langues, un VoiceOver plus clair et du texte plus grand. Le partage fonctionne de nouveau depuis l’écran du minuteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस भाषाएँ, बेहतर VoiceOver और बड़ा टेक्स्ट। टाइमर की अपनी स्क्रीन से शेयर करना भी फिर से काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepuluh bahasa, VoiceOver yang lebih jelas, dan teks lebih besar. Berbagi juga kembali berfungsi dari layar timer itu sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez idiomas, VoiceOver mais claro e texto maior. E compartilhar voltou a funcionar na própria tela do timer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Десять языков, более понятный VoiceOver и крупный текст. А делиться снова можно прямо с экрана таймера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持十种语言，VoiceOver 更清晰，文字更大。在计时器自己的页面上也能再次共享。"
          }
        }
      }
    },
    "That date has already passed — pick one in the future.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التاريخ قد مضى — اختر تاريخًا في المستقبل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই তারিখ পেরিয়ে গেছে — ভবিষ্যতের কোনো তারিখ বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa fecha ya pasó: elige una futura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette date est déjà passée — choisissez-en une à venir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तारीख बीत चुकी है — आगे की कोई तारीख चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal itu sudah lewat — pilih tanggal di masa depan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa data já passou — escolha uma data futura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта дата уже прошла — выберите будущую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该日期已过——请选择未来的日期。"
          }
        }
      }
    },
    "That sequence has not started yet. You can change it after it starts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ هذا التسلسل بعد. يمكنك تغييره بعد أن يبدأ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সিকোয়েন্স এখনো শুরু হয়নি। শুরু হওয়ার পরে বদলাতে পারবেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa secuencia aún no ha empezado. Puedes cambiarla cuando empiece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette séquence n’a pas encore commencé. Vous pourrez la modifier une fois lancée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सीक्वेंस अभी शुरू नहीं हुआ है। शुरू होने के बाद आप इसे बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutan itu belum dimulai. Anda bisa mengubahnya setelah dimulai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa sequência ainda não começou. Você pode alterá-la depois que começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта последовательность ещё не началась. Её можно изменить после начала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该序列尚未开始，开始后才能更改。"
          }
        }
      }
    },
    "That timer has finished. Repeat it in the app to start it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى هذا المؤقت. كرّره في التطبيق لبدئه من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাইমার শেষ হয়েছে। আবার শুরু করতে অ্যাপে পুনরাবৃত্তি করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese temporizador ha terminado. Repítelo en la app para volver a iniciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce minuteur est terminé. Répétez-le dans l’app pour le relancer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टाइमर खत्म हो चुका है। फिर से शुरू करने के लिए ऐप में दोहराएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer itu sudah selesai. Ulangi di app untuk memulainya lagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse timer terminou. Repita-o no app para começar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот таймер завершён. Повторите его в приложении, чтобы запустить снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该计时器已结束。请在 App 中重复以重新开始。"
          }
        }
      }
    },
    "That timer is no longer available. Choose another timer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المؤقت لم يعد متاحًا. اختر مؤقتًا آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাইমার আর নেই। অন্য একটি টাইমার বেছে নিন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese temporizador ya no está disponible. Elige otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce minuteur n’est plus disponible. Choisissez-en un autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टाइमर अब उपलब्ध नहीं है। कोई दूसरा टाइमर चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer itu sudah tidak tersedia. Pilih timer lain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse timer não está mais disponível. Escolha outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот таймер больше недоступен. Выберите другой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该计时器已不可用，请选择其他计时器。"
          }
        }
      }
    },
    "That timer was shared with you as view only. Only its owner can change it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت مشاركة هذا المؤقت معك للعرض فقط. لا يمكن تغييره إلا لمالكه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাইমার আপনার সাথে শুধু দেখার জন্য শেয়ার করা হয়েছে। শুধু এর মালিক এটি বদলাতে পারেন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese temporizador se compartió contigo solo para ver. Solo su propietario puede cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce minuteur a été partagé avec vous en lecture seule. Seul son propriétaire peut le modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टाइमर आपके साथ सिर्फ़ देखने के लिए शेयर किया गया है। इसे सिर्फ़ इसका मालिक बदल सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer itu dibagikan kepada Anda hanya untuk dilihat. Hanya pemiliknya yang bisa mengubahnya."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse timer foi compartilhado com você somente para visualização. Só o dono pode alterá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С вами поделились этим таймером только для просмотра. Изменить его может только владелец."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该计时器以“仅查看”方式与你共享，只有其所有者可以更改。"
          }
        }
      }
    },
    "The share screen shows the timer and tells you whether the link stays in sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض شاشة المشاركة المؤقت وتخبرك إن كان الرابط سيبقى متزامنًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার স্ক্রিন টাইমারটি দেখায় এবং জানায় লিঙ্কটি সিঙ্কে থাকবে কি না।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de compartir muestra el temporizador y te indica si el enlace se mantiene sincronizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran de partage affiche le minuteur et vous indique si le lien reste synchronisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर स्क्रीन टाइमर दिखाती है और बताती है कि लिंक सिंक में रहेगा या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar berbagi menampilkan timer dan memberi tahu apakah tautan tetap tersinkron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela de compartilhamento mostra o timer e informa se o link continua sincronizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран «Поделиться» показывает таймер и сообщает, будет ли ссылка синхронизироваться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享页面会显示计时器，并告诉你链接是否保持同步。"
          }
        }
      }
    },
    "This timer has been deleted or has expired.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف هذا المؤقت أو انتهت صلاحيته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টাইমারটি মুছে ফেলা হয়েছে বা মেয়াদ শেষ হয়ে গেছে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este temporizador se ha eliminado o ha caducado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce minuteur a été supprimé ou a expiré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
