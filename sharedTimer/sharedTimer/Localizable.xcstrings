    "Set the name people see, pick one of four alarm tones, and replay this tour, all in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن الاسم الذي يراه الآخرون، واختر واحدة من أربع نغمات تنبيه، وأعد مشاهدة هذه الجولة، كل ذلك في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্যরা যে নাম দেখবেন তা সেট করুন, চারটি অ্যালার্ম টোনের একটি বেছে নিন এবং এই ট্যুর আবার দেখুন, সবই সেটিংসে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el nombre que ven los demás, uno de cuatro tonos de alarma y vuelve a ver este recorrido, todo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le nom que les autres voient, l’une des quatre sonneries d’alarme, et revoyez cette visite, le tout dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोगों को दिखने वाला नाम सेट करें, चार अलार्म टोन में से एक चुनें और यह टूर दोबारा देखें, सब सेटिंग्ज़ में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur nama yang dilihat orang lain, pilih salah satu dari empat nada alarm, dan putar ulang tur ini, semuanya di Pengaturan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o nome que as pessoas veem, escolha um dos quatro sons de alarme e reveja este tour, tudo em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте имя, которое видят другие, выберите один из четырех звуков будильника и пересмотрите этот обзор — всё в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置别人看到的名称，从四种闹钟铃声中选择，还能重温本导览，都在“设置”中。"
          }
        }
      }
    },
