    "Pause a timer, countdown, or the current sequence phase.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停计时器、倒计时或当前序列阶段。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमर, काउंटडाउन या सीक्वेंस का मौजूदा चरण पॉज़ करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa un temporizador, una cuenta atrás o la fase actual de una secuencia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف مؤقتًا أو عدًا تنازليًا أو المرحلة الحالية من التسلسل مؤقتًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez en pause un minuteur, un compte à rebours ou la phase en cours d’une séquence."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি টাইমার, কাউন্টডাউন বা সিকোয়েন্সের বর্তমান ধাপে বিরতি দিন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause um timer, uma contagem regressiva ou a fase atual de uma sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановить таймер, отсчет или текущую фазу последовательности."
          }
        },
        "id": {
