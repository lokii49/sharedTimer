    "See who has a shared timer, remove someone, or stop sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف من لديه مؤقت مشترك، أو أزِل أحدًا، أو أوقف المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখুন শেয়ার করা টাইমার কার কাছে আছে, কাউকে সরান বা শেয়ার করা বন্ধ করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira quién tiene un temporizador compartido, quita a alguien o deja de compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez qui a un minuteur partagé, retirez quelqu’un ou arrêtez le partage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि शेयर किया गया टाइमर किसके पास है, किसी को हटाएँ या शेयर करना बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat siapa yang memiliki timer bersama, hapus seseorang, atau berhenti berbagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quem tem um timer compartilhado, remova alguém ou pare de compartilhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите, у кого есть общий таймер, удаляйте участников или закрывайте доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看谁拥有共享计时器，移除某人，或停止共享。"
          }
        }
      }
    },
    "Selects and plays this tone": {
