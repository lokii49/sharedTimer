            "state": "translated",
            "value": "Assistance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukungan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suporte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддержка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持"
          }
        }
      }
    },
    "Take the tour of this version again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد جولة هذا الإصدار مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভার্সনের ট্যুরটি আবার দেখুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ver el recorrido de esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refaites la visite de cette version."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्शन का टूर फिर से देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti lagi tur versi ini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o tour desta versão novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдите обзор этой версии еще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次浏览此版本的导览。"
          }
        }
      }
    },
    "Tap + to start one, or share a timer from iMessage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على + لبدء مؤقت، أو شارك مؤقتًا من iMessage."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে + ট্যাপ করুন, অথবা iMessage থেকে একটি টাইমার শেয়ার করুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para crear uno o comparte un temporizador desde iMessage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour en créer un, ou partagez un minuteur depuis iMessage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए + पर टैप करें, या iMessage से टाइमर शेयर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk + untuk memulai, atau bagikan timer dari iMessage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em + para iniciar um ou compartilhe um timer pelo iMessage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите +, чтобы создать таймер, или поделитесь им из iMessage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 + 新建一个，或从 iMessage 共享计时器。"
          }
        }
      }
    },
    "Target Date": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
