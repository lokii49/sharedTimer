    "Added %@ to %@. %@ left.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إضافة %@ إلى %@. المتبقي %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এ %1$@ যোগ করা হয়েছে। %3$@ বাকি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Added %1$@ to %2$@. %3$@ left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha añadido %@ a %@. Queda %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout de %@ à %@. Il reste %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ में जोड़ा गया। %@ बाकी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan %@ ke %@. Sisa %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adicionado(s) a %@. Faltam %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено %1$@ к «%2$@». Осталось %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为%2$@增加 %1$@。还剩 %3$@。"
          }
        }
      }
    },
    "Added %@ to %@. It is still paused with %@ left.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إضافة %@ إلى %@. لا يزال متوقفًا مؤقتًا والمتبقي %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এ %1$@ যোগ করা হয়েছে। এটি এখনও বিরতিতে আছে, %3$@ বাকি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Added %1$@ to %2$@. It is still paused with %3$@ left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha añadido %@ a %@. Sigue en pausa con %@ restante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout de %@ à %@. Toujours en pause, il reste %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ में जोड़ा गया। यह अभी भी पॉज़ है, %@ बाकी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan %@ ke %@. Masih dijeda dengan sisa %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adicionado(s) a %@. Continua pausado e faltam %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено %1$@ к «%2$@». Таймер по-прежнему на паузе, осталось %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为%2$@增加 %1$@。仍处于暂停状态，还剩 %3$@。"
          }
        }
      }
