    "Shared links now open from mirrornotes.org, and Messages shows the timer's name before anyone taps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الروابط المشتركة الآن من mirrornotes.org، وتعرض الرسائل اسم المؤقت قبل أن ينقر أي أحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার করা লিঙ্ক এখন mirrornotes.org থেকে খোলে, আর কেউ ট্যাপ করার আগেই Messages টাইমারের নাম দেখায়।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces compartidos ahora se abren desde mirrornotes.org, y Mensajes muestra el nombre del temporizador antes de que nadie toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens partagés s’ouvrent désormais depuis mirrornotes.org, et Messages affiche le nom du minuteur avant même que quiconque touche le lien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर किए गए लिंक अब mirrornotes.org से खुलते हैं, और किसी के टैप करने से पहले ही Messages टाइमर का नाम दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan bersama kini dibuka dari mirrornotes.org, dan Pesan menampilkan nama timer sebelum ada yang mengetuk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links compartilhados agora abrem pelo mirrornotes.org, e o Mensagens mostra o nome do timer antes de alguém tocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общие ссылки теперь открываются с mirrornotes.org, а Сообщения показывают название таймера еще до нажатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享链接现在从 mirrornotes.org 打开，在别人轻点之前，“信息”就会显示计时器名称。"
          }
        }
      }
    },
