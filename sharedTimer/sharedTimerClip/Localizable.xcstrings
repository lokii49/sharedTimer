    "Open a shared timer link to see the live countdown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح رابط مؤقت مشترك لمشاهدة العد التنازلي المباشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ কাউন্টডাউন দেখতে একটি শেয়ার করা টাইমার লিঙ্ক খুলুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el enlace de un temporizador compartido para ver la cuenta atrás en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le lien d’un minuteur partagé pour voir le compte à rebours en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव काउंटडाउन देखने के लिए शेयर किया गया टाइमर लिंक खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tautan timer yang dibagikan untuk melihat hitung mundur langsung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o link de um timer compartilhado para ver a contagem ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте ссылку на общий таймер, чтобы увидеть живой отсчет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开共享的计时器链接即可查看实时倒计时。"
          }
        }
      }
    },
