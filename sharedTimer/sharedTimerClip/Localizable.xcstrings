{
  "sourceLanguage": "en",
  "strings": {
    "Live countdown from a shared timer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自共享计时器的实时倒计时"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेयर किए गए टाइमर का लाइव काउंटडाउन"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta atrás en directo de un temporizador compartido"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد تنازلي مباشر من مؤقت مشترك"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à rebours en direct d’un minuteur partagé"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার করা টাইমারের লাইভ কাউন্টডাউন"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagem ao vivo de um timer compartilhado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живой отсчет общего таймера"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung mundur langsung dari timer yang dibagikan"
          }
        }
      }
    },
    "Open a shared timer link to see the live countdown.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开共享的计时器链接即可查看实时倒计时。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव काउंटडाउन देखने के लिए शेयर किया गया टाइमर लिंक खोलें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el enlace de un temporizador compartido para ver la cuenta atrás en directo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح رابط مؤقت مشترك لمشاهدة العد التنازلي المباشر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le lien d’un minuteur partagé pour voir le compte à rebours en direct."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ কাউন্টডাউন দেখতে একটি শেয়ার করা টাইমার লিঙ্ক খুলুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o link de um timer compartilhado para ver a contagem ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте ссылку на общий таймер, чтобы увидеть живой отсчет."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tautan timer yang dibagikan untuk melihat hitung mundur langsung."
          }
        }
      }
    },
